{
  "name": "starmusic",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "bin": {
    "starmusic": "src/main/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [],
  "author": "razzzaa00",
  "license": "MIT",
  "description": "StarMusic - ad-free, lightweight music player (YouTube Music, SoundCloud, local files). Based on Riff.",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.3",
    "tone": "^15.1.22"
  },
  "productName": "StarMusic",
  "homepage": "https://github.com/razzzaa00/starmusic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razzzaa00/starmusic.git"
  },
  "bugs": {
    "url": "https://github.com/razzzaa00/starmusic/issues"
  },
  "build": {
    "appId": "io.github.razzzaa00.starmusic",
    "productName": "StarMusic",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "razzzaa00",
        "repo": "starmusic",
        "releaseType": "release"
      }
    ]
  }
}
